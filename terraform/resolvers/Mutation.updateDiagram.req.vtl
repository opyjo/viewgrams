## Build expression values map with plain values, then convert to DynamoDB format
#set($expValues = {})
$util.qr($expValues.put(":title", $ctx.args.input.title))
$util.qr($expValues.put(":description", $ctx.args.input.description))
$util.qr($expValues.put(":code", $ctx.args.input.code))
$util.qr($expValues.put(":svgPreview", $ctx.args.input.svgPreview))
$util.qr($expValues.put(":tags", $ctx.args.input.tags))
$util.qr($expValues.put(":updatedAt", $util.time.nowISO8601()))

## Handle projectId: SET if not null, REMOVE if null (GSI cannot index NULL values)
#if($ctx.args.input.projectId)
  #set($setExpression = "SET title = :title, description = :description, code = :code, svgPreview = :svgPreview, tags = :tags, projectId = :projectId, updatedAt = :updatedAt")
  $util.qr($expValues.put(":projectId", $ctx.args.input.projectId))
#else
  #set($setExpression = "SET title = :title, description = :description, code = :code, svgPreview = :svgPreview, tags = :tags, updatedAt = :updatedAt REMOVE projectId")
#end

{
  "version": "2017-02-28",
  "operation": "UpdateItem",
  "key": {
    "userId": $util.dynamodb.toDynamoDBJson($ctx.identity.sub),
    "id": $util.dynamodb.toDynamoDBJson($ctx.args.input.id)
  },
  "update": {
    "expression": "$setExpression",
    "expressionValues": $util.dynamodb.toMapValuesJson($expValues)
  }
}
